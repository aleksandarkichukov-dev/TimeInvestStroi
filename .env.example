# Изпращане на формата „Поискай оферта“ (src/app/api/oferta/route.ts).
# Копирайте като .env.local за локална работа или .env.production на сървъра.

# Вариант 1 (на хостинга): през пощенския сървър на сървъра, без парола.
MAIL_TRANSPORT=sendmail
# SENDMAIL_PATH=/usr/sbin/sendmail

# Вариант 2: SMTP с парола (ако MAIL_TRANSPORT не е sendmail).
# SMTP_HOST=mail.timeinveststroy.com
# SMTP_PORT=465
# SMTP_USER=office@timeinveststroy.com
# SMTP_PASS=

# По избор:
# MAIL_FROM="Тайминвест Строй – сайт <office@timeinveststroy.com>"
# MAIL_TO=office@timeinveststroy.com
